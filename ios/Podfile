# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Explicitly map custom prod flavor configurations to their correct modes.
project 'Runner', {
  'Debug'   => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__
  )
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. " \
          "If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. " \
        "Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root
)

flutter_ios_podfile_setup

target 'Runner' do
  # REQUIRED for flutter_onnxruntime: onnxruntime-objc and onnxruntime-c ship
  # as statically linked binaries. Using dynamic frameworks causes:
  #   "The 'Pods-Runner' target has transitive dependencies that include
  #    statically linked binaries: (onnxruntime-objc and onnxruntime-c)"
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# NOTE: CocoaPods only allows ONE post_install hook — everything is merged here.
post_install do |installer|
  # ── 1. Patch every Pod target ─────────────────────────────────────────────
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Debug: no optimization, active arch only (fast iteration).
      # Release/Profile: standard optimization.
      if config.name == 'Debug'
        config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0'
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      else
        config.build_settings['GCC_OPTIMIZATION_LEVEL'] = 's'
      end

      # Some pods (Promises via Firebase) require iOS 15.5+; without this
      # they inherit a lower default and Xcode compiles them at 15.0.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['COMPRESS_DATA_FILES'] = 'NO'

      # permission_handler compiles in only the permissions the app asks
      # for; any other would always read as denied.
      if target.name == 'permission_handler_apple'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = [
          '$(inherited)',
          'PERMISSION_CAMERA=1',
          'PERMISSION_LOCATION_WHENINUSE=1',
          'PERMISSION_NOTIFICATIONS=1',
        ]
      end
    end
  end

  # ── 2. Patch the Runner app target in Runner.xcodeproj ────────────────────
  # Runner is NOT part of installer.pods_project. Patch it separately and only
  # save when something actually changed, so repeated `pod install` runs don't
  # dirty the project or trigger Xcode "project modified" prompts.
  runner_project_path = File.join(__dir__, 'Runner.xcodeproj')
  if File.exist?(runner_project_path)
    require 'xcodeproj'
    project = Xcodeproj::Project.open(runner_project_path)
    changed = false

    project.targets.each do |target|
      next unless target.name == 'Runner'

      target.build_configurations.each do |config|
        settings = config.build_settings

        %w[
          STRIP_INSTALLED_PRODUCT
          DEPLOYMENT_POSTPROCESSING
          DEAD_CODE_STRIPPING
        ].each do |key|
          if settings[key] != 'NO'
            settings[key] = 'NO'
            changed = true
          end
        end

        if settings['STRIP_STYLE'] != 'non-global'
          settings['STRIP_STYLE'] = 'non-global'
          changed = true
        end

        # Align Runner's own IPHONEOS_DEPLOYMENT_TARGET with the Podfile's
        # `platform :ios, '16.0'`, independent of Xcode project defaults.
        if settings['IPHONEOS_DEPLOYMENT_TARGET'] != '16.0'
          settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
          changed = true
        end
      end
    end

    project.save if changed
  end
end
